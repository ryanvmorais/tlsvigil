# --- 1. PYTHON: BYTECODE, BUILD, PACKAGING ---
# Compiled bytecode and packaging output — all regenerated by the build, never source.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- 2. VIRTUAL ENVIRONMENTS (uv) ---
# `uv sync` recreates these. uv.lock IS committed, for reproducible tooling.
.venv/
venv/

# --- 3. TOOLING CACHES ---
# ruff, mypy, pytest, coverage — local speed-ups, never useful in Git.
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- 4. CHECK OUTPUT ---
# What `tlsvigil --json` is redirected to while trying it out. Ephemeral by design.
tlsvigil-*.json
# The state file `tlsvigil check --notify` writes by default (--state chooses another).
.tlsvigil-state.json

# --- 5. SECRETS AND LOCAL CONFIG ---
# Real secrets (Telegram token, SMTP password) live in the CI's secret store, never in a file.
.env
tlsvigil.local.toml

# --- 6. EDITOR AND OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- 7. LOCAL PLANNING / SCRATCH NOTES ---
# Superseded by specs/ once a feature is designed; never part of history.
/*.plan.md
.plans/
